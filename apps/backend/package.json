{
  "name": "cosmere-card-game",
  "version": "1.0.0",
  "description": "Backend for a Marvel-Snap-style card game, implementing core game logic and real-time communication with Socket.io.",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.{js,ts}",
    "lint:fix": "eslint src/**/*.{js,ts} --fix",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "card game",
    "real-time",
    "socket.io",
    "game logic",
    "multiplayer",
    "cosmere",
    "Marvel Snap",
    "Stormlight Archive",
    "Mistborn",
    "Elantris",
    "Warbreaker",
    "White Sand"
  ],
  "author": "Daniel Cabral",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.4",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  }
}
